# ---------------------------------------------------------------------------
# Notion API (server-side only — used by the Python build pipeline)
# Required by lib/notion_projects_export.py (run via `npm run fetch-notion-projects`).
# Create a Notion integration at https://www.notion.so/my-integrations and add
# its "Internal Integration Token" as NOTION_API_KEY. Then add the integration
# as a connection on each of the six databases listed below.
# ---------------------------------------------------------------------------
NOTION_API_KEY=

# Notion database IDs (copy from the URL of each database page in Notion)
NOTION_PROJECTS_DB_ID=
NOTION_COLLECTIONS_DB_ID=
NOTION_ASSETS_DB_ID=
NOTION_RESOURCES_DB_ID=
NOTION_CONFIG_DB_ID=
NOTION_WORK_LOGS_DB_ID=

NEXT_PUBLIC_FIREBASE_ANALYTICS_ENABLED=false
# Defense in depth: GA4 is only permitted on these production hostnames. Local
# development, Firebase preview URLs, and automated browsers are suppressed.
NEXT_PUBLIC_ANALYTICS_DISABLED=false
NEXT_PUBLIC_ANALYTICS_ALLOWED_HOSTS=zacharysturman.com,www.zacharysturman.com
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Cloudflare Worker (contact form, newsletter interest, daily summary mailer)
# Public defaults are versioned in lib/contact-config.json. Override at build
# time only when using a different API or Turnstile widget. Never add secrets here.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=
# Cloudflare Turnstile site key (public). Paired server secret lives in Worker.
# Allow both production hostnames in the widget. See docs/setup/contact-intake.md.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only intake values NOTION_API_KEY, RESEND_API_KEY, CONTACT_TO_EMAIL,
# TURNSTILE_SECRET, INTERNAL_TOKEN must also be set as Cloudflare Worker secrets.
# Do not prefix any secret with NEXT_PUBLIC_. D1/Notion IDs live in wrangler.toml.

# Local Hammerspoon portfolio publisher reporting only. These are server-side
# values; never expose either with a NEXT_PUBLIC_ prefix or commit .env.local.
API_BASE_URL=https://api.zacharysturman.com
INTERNAL_TOKEN=

# Optional local-only natural-language pass for the daily analytics report.
# Leave blank for the deterministic report. Non-loopback URLs are rejected.
LM_STUDIO_BASE_URL=http://127.0.0.1:1234
LM_STUDIO_MODEL=

# ---------------------------------------------------------------------------
# Cloudflare R2 media (server-side only — used by the Python build pipeline)
# Leave unset to disable hosted media uploads. The pipeline still works without
# these and will keep referencing local repo media.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=https://media.zacharysturman.com
