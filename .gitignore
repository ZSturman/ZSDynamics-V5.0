/public/deployment.json

# Intermediate Notion export (throw-away file, regenerated by fetch-notion-projects)
/tmp/

# Media optimization - ignore originals, keep optimized versions
# This prevents large unoptimized files from bloating the repo
public/projects/**/*.jpg
public/projects/**/*.jpeg
public/projects/**/*.png
public/projects/**/*.mp4
public/projects/**/*.mov
public/projects/**/*.webm
public/projects/**/*.avi

# But DO commit optimized versions
!public/projects/**/*-optimized.*
!public/projects/**/*-thumb.*
!public/projects/**/*-placeholder.*
!public/projects/**/*-preview-*.jpg

n8n_projects_from_notion.json

